# ─── Database (Prisma → Supabase Postgres) ──────────────────────────────────
# Transaction-mode pooler (used at runtime by Next.js)
DATABASE_URL="postgresql://postgres.XXXXX:YOUR_PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&connect_timeout=30&pool_timeout=30"

# Session-mode pooler (used for Prisma migrations: npx prisma db push)
DIRECT_URL="postgresql://postgres.XXXXX:YOUR_PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres"

# ─── Auth (JWT) ──────────────────────────────────────────────────────────────
# REQUIRED — the app will crash on startup if this is missing.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_STRING
JWT_EXPIRES_IN=7d

# ─── Supabase Admin Client ───────────────────────────────────────────────────
# Used server-side only for admin_users table lookups during login.
SUPABASE_URL=https://XXXXX.supabase.co
SUPABASE_SERVICE_KEY=eyJ...your_service_role_key_here

# ─── Cloudinary (image uploads) ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXX

# ─── WhatsApp Contact (public — safe to commit) ─────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER="94771766134"
NEXT_PUBLIC_WHATSAPP_DISPLAY="+94 77 17 66 134"

# ─── Email (Gmail SMTP for inquiry forms) ────────────────────────────────────
# GMAIL_APP_PASSWORD is a 16-character App Password from Google,
# NOT your normal Gmail password. Generate one at:
# https://myaccount.google.com/apppasswords
# Optional: Custom SMTP (e.g., Lankahost)
SMTP_HOST="mail.lankahost.lk"
SMTP_PORT="465"
SMTP_USER="info@nomadicventures.lk"
SMTP_PASSWORD="your-secure-password"

# Gmail fallback (used if SMTP_HOST is not set)
GMAIL_USER="nirmalgayantha55@gmail.com"
GMAIL_APP_PASSWORD="dummy"
INQUIRY_TO_EMAIL=your_email@gmail.com
